rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users collection: users can read profiles, but edit ONLY their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
                    (!request.resource.data.keys().hasAny(['reportedCatsCount', 'catBadges', 'rescueStars']) ||
                     (request.resource.data.get('reportedCatsCount', 0) == 0 &&
                      request.resource.data.get('catBadges', 0) == 0 &&
                      request.resource.data.get('rescueStars', 0) == 0));
      allow update: if isOwner(userId) &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reportedCatsCount', 'catBadges', 'rescueStars']);
      allow delete: if isOwner(userId);
      
      // Diary subcollection: only owner can read/write
      match /diary/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // Backups subcollection: only owner can read/write
      match /backups/{document=**} {
        allow read, write: if isOwner(userId);
      }
      
      // Pets subcollection: only owner can read/write
      match /pets/{petId} {
        allow read, write: if isOwner(userId);
      }

      // Actions subcollection: owner can create actions and view them
      match /actions/{actionId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    // Reports collection: allow guests and authenticated users to create reports
    match /reports/{reportId} {
      allow read: if true;
      allow create: if (request.auth != null && request.resource.data.reportedBy == request.auth.uid)
                   || (request.auth == null && request.resource.data.reportedBy == "");
      allow update: if isAuthenticated() &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reporterName', 'reportedBy', 'latitude', 'longitude', 'createdAt']);
      allow delete: if false;
      
      // Reaches subcollection: only owner of the reach can create/update
      match /reaches/{userId} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(userId);
        allow delete: if false;
      }
    }

    // Feeding Stations collection
    match /feedingStations/{stationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                   && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated();
      
      // Reaches subcollection: only owner of the reach can create/update
      match /reaches/{userId} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(userId);
        allow delete: if false;
      }
    }

    // Stats collection: Public aggregate statistics for Website & TinyPaws App
    match /stats/{docId} {
      // Public read for the website and app without requiring authentication
      allow read: if true;
      
      // Allow initializing the global document ONLY at 0 if it doesn't exist yet
      allow create: if docId == 'global'
                    && request.resource.data.downloads == 0
                    && request.resource.data.catsHelped == 0;
      
      // Strict atomic update rule:
      // ONLY the public website download button may update stats/global by incrementing downloads by exactly +1.
      // Direct client modification of catsHelped is strictly FORBIDDEN for all clients.
      // (catsHelped is incremented server-side by Cloud Functions exclusively upon verified actions).
      allow update: if docId == 'global'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads', 'updatedAt'])
                    && request.resource.data.downloads == resource.data.downloads + 1
                    && request.resource.data.catsHelped == resource.data.catsHelped;
      
      allow delete: if false;
    }

    // Statistics collection: strictly read-only for clients (updated via Cloud Functions)
    match /statistics/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Internal idempotency records: strictly server-only (Cloud Functions)
    match /internal_processed_actions/{docId} {
      allow read, write: if false;
    }
    
    // Feedback collection: allow authenticated and anonymous users to submit feedback
    match /feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Mail collection: authenticated users can only create mail with their own userId
    match /mail/{mailId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}

